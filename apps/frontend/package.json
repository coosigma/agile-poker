{
	"name": "@agile-poker/frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"dev:playground": "vite --host 0.0.0.0 --open /playground.html",
		"build": "tsc -p tsconfig.json && vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@agile-poker/app-core": "workspace:*",
		"@vitejs/plugin-react": "^5.1.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"vite": "^7.3.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"jsdom": "^25.0.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
}
